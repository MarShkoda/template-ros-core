<launch>
    <arg name="veh" default="$(env VEHICLE_NAME)"/>

    <group ns="$(arg veh)">

        <remap from="circle_drive/car_cmd"
               to="joy_mapper_node/car_cmd"/>

        <node name="circle_drive"
              pkg="circle_drive"
              type="circle_drive.py"
              output="screen"
              required="true">

            <rosparam command="load"
                      file="$(find circle_drive)/config/controllers.yaml"/>

        </node>

    </group>
</launch>
